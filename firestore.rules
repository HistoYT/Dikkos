rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de correos del equipo Dikkos. Cualquier cuenta autenticada
    // con uno de estos correos se trata como administrador. Ahora que
    // los CLIENTES normales también pueden crear cuentas (login de
    // usuario), ya no basta con "request.auth != null" para decidir
    // quién es admin — hay que revisar el correo explícitamente.
    // Para agregar un nuevo agente: créale su usuario en Firebase
    // Authentication y añade su correo aquí, luego vuelve a publicar
    // estas reglas (firebase deploy --only firestore:rules).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in [
          'davidmontoya20017@gmail.com'
        ];
    }

    match /orders/{orderId} {
      // Los pedidos ahora requieren cuenta de cliente (login obligatorio
      // antes de comprar): solo un usuario autenticado puede crear uno.
      // El admin también crea pedidos manuales desde el panel, y su
      // cuenta ya está autenticada, así que sigue funcionando igual.
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /chats/{orderId} {
      allow get: if true;
      allow create, update: if true;
      // El admin ve todos los chats; un cliente logueado solo puede
      // listar los suyos (su consulta debe filtrar por customerUid).
      allow list: if isAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow get, list, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Carrito de un cliente logueado: solo él puede leerlo/escribirlo.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
